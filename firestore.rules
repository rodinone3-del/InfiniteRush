rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /runs/{runId} {
      // Перевірка даних запису рейтингу.
      function valid(d) {
        return d.keys().hasOnly(['name','wave','kills','score','arena','picks','bossKills','secs','pickups','dealt','stats','lvl','skills','gear','uid','createdAt'])
          && d.keys().hasAll(['name','wave','kills','score','uid','createdAt'])
          && d.uid == request.auth.uid
          && d.createdAt == request.time
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
          && d.wave is int && d.wave >= 1 && d.wave <= 500
          && d.kills is int && d.kills >= 0 && d.kills <= d.wave * 100
          && d.score == d.wave * 1000000 + d.kills
          && (!('arena' in d) || (d.arena is string && d.arena.size() <= 30))
          && (!('picks' in d) || (d.picks is list && d.picks.size() <= 300))
          && (!('stats' in d) || d.stats is map)
          && (!('lvl' in d) || (d.lvl is int && d.lvl >= 1 && d.lvl <= 500))
          && (!('skills' in d) || d.skills is map)
          && (!('gear' in d) || (d.gear is list && d.gear.size() <= 4));
      }

      // Рейтинг читають усі.
      allow read: if true;

      // Один запис на гравця: id документа = його uid (анонімна авторизація).
      allow create: if request.auth != null && runId == request.auth.uid && valid(request.resource.data);

      // Перезаписувати свій запис можна лише коли новий результат кращий.
      allow update: if request.auth != null && runId == request.auth.uid
        && resource.data.uid == request.auth.uid
        && valid(request.resource.data)
        && request.resource.data.score > resource.data.score;

      allow delete: if false;
    }
  }
}
